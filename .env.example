# Order Automation - Environment Variables
# Copy this file to .env and fill in your values.
# .env is gitignored and must never be committed.

# AI API Key for the LLM parser (configured in-app via Settings → AI Analysis)
AI_API_KEY=

# Full path to python.exe (optional; falls back to python/python3/py on PATH)
# Example: C:\Users\<you>\AppData\Local\Programs\Python\Python312\python.exe
PYTHON_PATH=
